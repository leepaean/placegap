# Optional OpenAI-compatible provider for evidence-bound Finding proposals.
# Copy this file to .env and fill in your own key locally. .env is gitignored.

PLACEGAP_LLM_API_KEY=
PLACEGAP_LLM_BASE_URL=https://api.openai.com/v1
PLACEGAP_LLM_MODEL=gpt-5-mini

# Compatibility aliases are also supported:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# PLACEGAP_MODEL=
